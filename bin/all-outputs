#!/bin/bash

# omarchy:summary=Play on every connected output at once, with per-device volume
# omarchy:group=audio
# omarchy:args=[status|on|off|toggle|mixer|volume <device> <level>|mic [device]]
# omarchy:examples=all-outputs | all-outputs toggle | all-outputs volume buds 60 | all-outputs mic

set -uo pipefail

COMBINE="combine_all_outputs"
MAX_VOLUME=150

pa() { timeout 2 pactl "$@" 2>/dev/null; }

notify() {
  command -v omarchy-osd >/dev/null 2>&1 && omarchy-osd -i "${2:-volume-high}" -m "$1" && return 0
  echo "$1"
}

# Real hardware outputs only. The combine sink is itself an Audio/Sink, and
# feeding it into its own device list would be a loop.
devices_json() {
  pa -f json list sinks | jq -c --arg combine "$COMBINE" '[.[]
    | select(.name != $combine)
    | select(.name | test("^(alsa_output|bluez_output)\\."))
    | {
        index: .index,
        name: .name,
        description: (.description // .properties."device.description" // .name),
        muted: .mute,
        volume: (.volume | to_entries[0].value.value_percent | sub("%"; "") | tonumber)
      }]'
}

combine_index() {
  pa -f json list sinks | jq -r --arg combine "$COMBINE" \
    '.[] | select(.name == $combine) | .index' | head -1
}

combine_exists() { [[ -n $(combine_index) ]]; }

is_on() { [[ $(pa get-default-sink) == "$COMBINE" ]]; }

require_combine() {
  if ! combine_exists; then
    echo "The 'All Outputs' sink is not loaded." >&2
    echo "Click Set up in the All Outputs panel, or run setup/install.sh from the plugin folder." >&2
    exit 1
  fi
}

# A 0-150 bar. Anything above 100 is amplification, so it reads past the marker.
bar() {
  local pct=$1 width=20 filled
  filled=$((pct * width / MAX_VOLUME))
  ((filled > width)) && filled=$width
  ((filled < 0)) && filled=0
  printf '%s%s' "$(printf '━%.0s' $(seq 1 $filled 2>/dev/null))" \
    "$(printf '·%.0s' $(seq 1 $((width - filled)) 2>/dev/null))"
}

# Match on the human-readable description first, since that is what the device
# list shows; fall back to the node name so scripts can pin an exact sink.
resolve_device() {
  local query="$1" match
  match=$(devices_json | jq -r --arg q "$query" 'map(select(
      (.description | ascii_downcase | contains($q | ascii_downcase)) or
      (.name        | ascii_downcase | contains($q | ascii_downcase))
    )) | .[0].name // ""')

  if [[ -z $match ]]; then
    echo "No output matches '$query'. Connected outputs:" >&2
    devices_json | jq -r '.[] | "  " + .description' >&2
    return 1
  fi
  printf '%s\n' "$match"
}

cmd_status() {
  local state
  if is_on; then state="ON, every output is playing"; else state="OFF, only $(pa get-default-sink)"; fi
  echo "All Outputs: $state"
  echo

  local count
  count=$(devices_json | jq 'length')
  if ((count == 0)); then
    echo "  No outputs connected."
    return 0
  fi

  echo "  Per-device volume:"
  local name desc vol muted
  while IFS=$'\t' read -r name desc vol muted; do
    [[ -z $name ]] && continue
    local tag=""
    [[ $muted == "true" ]] && tag="  (muted)"
    printf '    %-28s %s %3d%%%s\n' "${desc:0:28}" "$(bar "$vol")" "$vol" "$tag"
  done < <(devices_json | jq -r '.[] | [.name, .description, .volume, .muted] | @tsv')
}

cmd_on() {
  require_combine
  local index
  index=$(combine_index)
  omarchy-audio-output-set-default "$index" "$COMBINE"

  # The taps are meant to sit at unity so the real sink is the only per-device
  # volume; WirePlumber may still have restored a level on one from before.
  local tap
  while read -r tap; do
    [[ -n $tap ]] && pa set-sink-input-volume "$tap" 100% 2>/dev/null
  done < <(pa -f json list sink-inputs |
    jq -r --arg c "$COMBINE" '.[] | select(.properties."node.name" // "" | startswith("output." + $c)) | .index')

  notify "All Outputs on"
}

# The output WirePlumber itself would fall back to: highest priority.session
# among the real devices. Leaving broadcast has to work from a hotkey with no
# terminal attached, so turning it off must never stop to ask which device.
best_device() {
  timeout 2 pw-dump 2>/dev/null | jq -r '
    [ .[] | select(.info.props."media.class" == "Audio/Sink")
          | select(.info.props."node.name" | test("^(alsa_output|bluez_output)\\."))
          | {name: .info.props."node.name", pri: (.info.props."priority.session" // 0)} ]
    | sort_by(.pri) | reverse | .[0].name // ""'
}

cmd_off() {
  local target="${1:-}" name index
  if [[ -n $target ]]; then
    name=$(resolve_device "$target") || exit 1
  else
    name=$(best_device)
    [[ -z $name ]] && { echo "No hardware output to fall back to." >&2; exit 1; }
  fi
  index=$(devices_json | jq -r --arg n "$name" '.[] | select(.name == $n) | .index')
  omarchy-audio-output-set-default "$index" "$name"
  notify "$(devices_json | jq -r --arg n "$name" '.[] | select(.name == $n) | .description')"
}

cmd_toggle() {
  if is_on; then cmd_off; else cmd_on; fi
}

# Resolve "+10" / "-10" / "70" against the current level, bounded to 0-MAX.
clamp_volume() {
  local current="$1" level="$2" target
  case "$level" in
    +*) target=$((current + ${level#+})) ;;
    -*) target=$((current - ${level#-})) ;;
    *) target=$level ;;
  esac
  ((target < 0)) && target=0
  ((target > MAX_VOLUME)) && target=$MAX_VOLUME
  printf '%s\n' "$target"
}

cmd_selftest() {
  local fail=0
  check() {
    local got
    got=$(clamp_volume "$2" "$3")
    if [[ $got != "$4" ]]; then
      echo "FAIL $1: clamp_volume $2 $3 -> $got (want $4)" >&2
      fail=1
    fi
  }
  check "absolute"      30 70    70
  check "relative up"   30 +10   40
  check "relative down" 30 -10   20
  check "floor"         5  -50   0
  check "ceiling"       140 +50  "$MAX_VOLUME"
  check "at ceiling"    30 999   "$MAX_VOLUME"
  ((fail == 0)) && echo "selftest ok"
  return $fail
}

cmd_volume() {
  local query="${1:-}" level="${2:-}" name current target
  if [[ -z $query || -z $level ]]; then
    echo "Usage: all-outputs volume <device> <0-$MAX_VOLUME|+N|-N|mute>" >&2
    exit 1
  fi

  name=$(resolve_device "$query") || exit 1

  if [[ $level == "mute" ]]; then
    pa set-sink-mute "$name" toggle
    notify "$(printf '%s %s' "$(devices_json | jq -r --arg n "$name" '.[] | select(.name==$n) | .description')" \
      "$(devices_json | jq -r --arg n "$name" '.[] | select(.name==$n) | if .muted then "muted" else "unmuted" end')")"
    return 0
  fi

  current=$(devices_json | jq -r --arg n "$name" '.[] | select(.name == $n) | .volume')
  target=$(clamp_volume "$current" "$level")

  # A muted device silently ignores a volume change, which reads as the command
  # having failed, so raising it above zero unmutes as well.
  ((target > 0)) && pa set-sink-mute "$name" 0
  pa set-sink-volume "$name" "${target}%"
  notify "$(devices_json | jq -r --arg n "$name" '.[] | select(.name == $n) | .description'): ${target}%"
}

sources_json() {
  # monitor_of_sink reads null even for monitors here, so the name suffix is the
  # only reliable way to keep loopback-of-output entries out of the mic list.
  pa -f json list sources | jq -c '[.[]
    | select(.name | endswith(".monitor") | not)
    | {index: .index, name: .name, description: (.description // .name)}]'
}

cmd_mic() {
  local query="${1:-}" name
  if [[ -n $query ]]; then
    name=$(sources_json | jq -r --arg q "$query" 'map(select(
        (.description | ascii_downcase | contains($q | ascii_downcase)) or
        (.name | ascii_downcase | contains($q | ascii_downcase))
      )) | .[0].name // ""')
    [[ -z $name ]] && { echo "No input matches '$query'." >&2; sources_json | jq -r '.[] | "  " + .description' >&2; exit 1; }
  else
    require_gum
    local current choice
    current=$(pa get-default-source)
    choice=$(sources_json | jq -r --arg cur "$current" '.[] | (if .name == $cur then "* " else "  " end) + .description + "\t" + .name' |
      gum choose --header "Use which microphone?" --height 12) || exit 0
    name=$(cut -f2 <<<"$choice")
  fi
  [[ -z $name ]] && exit 0

  local index
  index=$(sources_json | jq -r --arg n "$name" '.[] | select(.name == $n) | .index')
  omarchy-audio-input-set-default "$index" "$name"

  # A Bluetooth headset has no profile that runs a high quality A2DP stream and
  # the microphone at once. Selecting its mic drops it to headset mode, which
  # costs output quality on that device for as long as the mic is in use.
  if [[ $name == bluez_input.* ]]; then
    notify "Mic: $(sources_json | jq -r --arg n "$name" '.[] | select(.name==$n) | .description'), Bluetooth output drops to call quality while in use"
  else
    notify "Mic: $(sources_json | jq -r --arg n "$name" '.[] | select(.name==$n) | .description')"
  fi
}

require_gum() {
  command -v gum >/dev/null 2>&1 && return 0
  echo "This needs 'gum'. Use the non-interactive form instead, e.g." >&2
  echo "  all-outputs volume buds 60" >&2
  exit 1
}

pick_device() {
  require_gum
  local choice
  choice=$(devices_json | jq -r '.[] | .description + "\t" + .name' |
    gum choose --header "${1:-Pick an output}" --height 12) || return 1
  cut -f2 <<<"$choice"
}

cmd_mixer() {
  require_gum
  require_combine

  while true; do
    clear
    cmd_status
    echo

    local choice
    choice=$(
      {
        if is_on; then echo -e "Turn All Outputs OFF (pick one device)\toff"
        else echo -e "Turn All Outputs ON (play everywhere)\ton"; fi
        devices_json | jq -r '.[] | "Adjust " + .description + "\tdev:" + .name'
        echo -e "Switch microphone\tmic"
        echo -e "Quit\tquit"
      } | gum choose --header "All Outputs" --height 14
    ) || break

    local action
    action=$(cut -f2 <<<"$choice")
    case "$action" in
      on) cmd_on ;;
      off)
        local only
        only=$(pick_device "Play on which output only?") && cmd_off "$only"
        ;;
      mic) cmd_mic ;;
      quit | "") break ;;
      dev:*) adjust_loop "${action#dev:}" ;;
    esac
  done
  clear
}

adjust_loop() {
  local name="$1" desc step
  desc=$(devices_json | jq -r --arg n "$name" '.[] | select(.name == $n) | .description')

  while true; do
    clear
    local vol muted
    vol=$(devices_json | jq -r --arg n "$name" '.[] | select(.name == $n) | .volume')
    muted=$(devices_json | jq -r --arg n "$name" '.[] | select(.name == $n) | .muted')
    [[ -z $vol ]] && return 0

    echo "$desc"
    printf '  %s %3d%%%s\n\n' "$(bar "$vol")" "$vol" "$([[ $muted == true ]] && echo '  (muted)')"

    step=$(printf '%s\n' "+10" "-10" "Set exactly…" "Toggle mute" "Back" |
      gum choose --height 7) || return 0

    case "$step" in
      "+10") cmd_volume "$name" +10 >/dev/null ;;
      "-10") cmd_volume "$name" -10 >/dev/null ;;
      "Set exactly…")
        local v
        v=$(gum input --placeholder "0-$MAX_VOLUME") || continue
        [[ $v =~ ^[0-9]+$ ]] && cmd_volume "$name" "$v" >/dev/null
        ;;
      "Toggle mute") cmd_volume "$name" mute >/dev/null ;;
      *) return 0 ;;
    esac
  done
}

case "${1:-}" in
  status) cmd_status ;;
  on) cmd_on ;;
  off) shift; cmd_off "$@" ;;
  toggle) cmd_toggle ;;
  volume | vol) shift; cmd_volume "$@" ;;
  mic | input) shift; cmd_mic "$@" ;;
  mixer | "") cmd_mixer ;;
  selftest) cmd_selftest ;;
  -h | --help | help)
    echo "Usage: all-outputs [status|on|off|toggle|mixer|volume <device> <level>|mic [device]]"
    ;;
  *)
    echo "Unknown command: $1" >&2
    echo "Usage: all-outputs [status|on|off|toggle|mixer|volume <device> <level>|mic [device]]" >&2
    exit 1
    ;;
esac
